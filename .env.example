# ── Fighters Guild — Star Citizen tools ──────────────────────────────────────
# Create a webhook in the target Fluxer channel (channel settings → Integrations
# → Webhooks) and paste the URL here.

# Default webhook — used by any feed without its own.
FLUXER_WEBHOOK_URL=https://chat.example.com/api/webhooks/xxxx/yyyy

# Optional per-feed overrides (post each feed to a different channel):
#FLUXER_WEBHOOK_STATUS=
#FLUXER_WEBHOOK_COMMLINK=
#FLUXER_WEBHOOK_FUNDING=

# ── Feed toggles ────────────────────────────────────────────────────────────
FEED_RSI_STATUS=on          # RSI service status changes
FEED_COMM_LINKS=on          # new RSI comm-links (patch notes, reports, TWISC)
FEED_FUNDING=off            # crowdfunding milestone crossings
FEED_GITHUB_RELEASES=on     # new releases of watched repos (LUG Helper by default)

# Repos to watch for new releases (comma-separated owner/repo).
#GITHUB_RELEASE_REPOS=starcitizen-lug/lug-helper
#GITHUB_RELEASE_PRERELEASES=off

# Only post comm-links whose title/channel/category contains one of these
# (comma-separated, case-insensitive). Empty = post everything.
#COMM_LINK_FILTER=Patch Notes,Alpha,Star Citizen Live

# ── Schedules (cron) ────────────────────────────────────────────────────────
#CRON_RSI_STATUS=*/5 * * * *
#CRON_COMM_LINKS=*/20 * * * *
#CRON_FUNDING=0 */6 * * *

# ── Command bot (optional) ─────────────────────────────────────────────────
# Create a bot application in Fluxer, copy its bot token here. Then guild
# members can type "!sc status", "!sc ship <name>", "!sc patch", etc. in any
# channel the bot can see.
#FLUXER_BOT_TOKEN=
#FLUXER_API_BASE=https://chat.example.com   # defaults to the webhook's origin
#BOT_PREFIX=!sc
#UEX_API_KEY=                                          # optional; only raises UEX rate limits
# `!sc job` — channel where jobs are posted. The bot reformats the request into
# an embed and deletes the original message (needs the Manage Messages perm).
#JOB_BOARD_CHANNEL_ID=
